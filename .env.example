# ==============================================================================
# FLAREMINDS TECH PRIVATE LIMITED - Environment Variables Template
# ==============================================================================
# NOTE: Vite exposes variables starting with VITE_ to the client bundle.
# Do NOT store private secret keys (e.g. backend database credentials) here.
# Configure these variables in Render Dashboard -> Environment Settings.
# ==============================================================================

# EmailJS Service Configuration (Used in Contact Form)
# Public Client-side credentials - configure domain origin restrictions in EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Google Analytics 4 (GA4) Measurement ID (e.g. G-ABC1234567)
# Leave empty or set your real ID; dummy IDs are safely ignored
VITE_GA_MEASUREMENT_ID=
